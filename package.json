{
  "name": "reactiv-home-screen-editor",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently --kill-others-on-fail --names service,web --prefix-colors blue,magenta \"npm:dev:service\" \"npm:dev:web\"",
    "dev:service": "tsx watch service/main.ts",
    "dev:web": "react-router dev",
    "build": "react-router build",
    "start": "concurrently --kill-others --names service,web --prefix-colors blue,magenta \"npm:start:service\" \"npm:start:web\"",
    "start:service": "tsx service/main.ts",
    "start:web": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "hono": "^4.13.13",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
