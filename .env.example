# Copy to .env (or run `npm run setup`, which also generates the key). Never commit .env.

# Shared secret: the app server sends it as `Authorization: Bearer <key>`, the configuration
# service requires it. Server-side only. Must be at least 32 characters; there is no default,
# so a missing key stops both processes instead of running an open API.
CONFIG_SERVICE_API_KEY=

# Where the app server reaches the private configuration service.
CONFIG_SERVICE_URL=http://127.0.0.1:4000

# Port the configuration service listens on (bound to 127.0.0.1 only).
CONFIG_SERVICE_PORT=4000

# SQLite database file for the configuration service. Created on first start.
CONFIG_DB_PATH=./data/configurations.sqlite
